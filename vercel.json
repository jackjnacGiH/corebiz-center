{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "corebiz": {
      "entrypoint": "frontend",
      "routePrefix": "/center",
      "framework": "vite"
    },
    "shop": {
      "entrypoint": "apps/storefront",
      "routePrefix": "/",
      "framework": "nextjs"
    }
  },
  "headers": [
    {
      "source": "/center/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
